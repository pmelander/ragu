{
  "name": "ragu",
  "version": "1.0.0",
  "description": "Local document retrieval (LanceDB + hybrid search) for OpenCode and HTTP API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "bun --watch src/index.ts",
    "start": "bun dist/index.js",
    "mcp": "node mcp/ragu-mcp.js",
    "test": "bunx jest --config jest.config.cjs --passWithNoTests",
    "test:watch": "bunx jest --config jest.config.cjs --watch",
    "lint": "bunx eslint src/**/*.ts",
    "clean": "rm -rf dist data logs",
    "setup": "bun install && mkdir -p data/{documents,lancedb,lexical,cache} logs",
    "setup:full": "bun examples/setup.js"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.27.2",
    "@xenova/transformers": "^2.17.1",
    "axios": "^1.13.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "form-data": "^4.0.4",
    "minisearch": "^7.2.0",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "pdfjs-dist": "^5.4.394",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/connect": "^3.4.38",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^4.17.41",
    "@types/http-errors": "^2.0.4",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.0",
    "@types/qs": "^6.9.11",
    "@types/range-parser": "^1.2.7",
    "@types/send": "^0.17.4",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.3.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
